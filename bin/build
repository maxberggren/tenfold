#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build"
cd "$ROOT/build"

# TENFOLD_PORTABLE=1 builds for any processor of this architecture, as the
# released packages are; QMAKE names another qmake (another Qt).
if [ -n "${TENFOLD_PORTABLE:-}" ]; then
    "${QMAKE:-qmake6}" "$ROOT/tenfold.pro" CONFIG+=portable
else
    "${QMAKE:-qmake6}" "$ROOT/tenfold.pro"
fi
make -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"

# The Sampler's models' weights beside the program, where it finds them.
"$ROOT/bin/model" || echo "(built without the stem or restore model)" >&2

echo "Built $ROOT/build/tenfold"
