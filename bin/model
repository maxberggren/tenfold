#!/bin/sh
# Puts the stem separator's weights at build/htdemucs.tfq, where the program
# and the packages take them from: htdemucs, Demucs's Hybrid Transformer
# model (Meta, MIT licence, extras/LICENSE-htdemucs), in tenfold's compact
# form (40 MB; see src/stems.cpp), which the repository carries as
# extras/htdemucs.tfq.
#
#   bin/model          copy extras/htdemucs.tfq into build/
#   bin/model --remake make extras/htdemucs.tfq again from the published
#                      file (84 MB) and extras/htdemucs-bits.txt, after
#                      changing the bits
#
# --remake takes the published file as Hugging Face keeps it at a fixed
# commit: from Hugging Face's own cache when it is there, fetched otherwise,
# checked against its SHA-256 either way, and compacted by the tenfold just
# built (`tenfold stem-model`). bin/build runs the plain form.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
bundled="$ROOT/extras/htdemucs.tfq"
dest="$ROOT/build/htdemucs.tfq"
mkdir -p "$ROOT/build"

if [ "${1:-}" != "--remake" ]; then
    cmp -s "$bundled" "$dest" 2>/dev/null || cp "$bundled" "$dest"
    # The restorer's weights: Apollo (Kai Li and Yi Luo, CC BY-SA 4.0,
    # extras/LICENSE-apollo), 66 MB, as Hugging Face keeps them at a fixed
    # commit, fetched and checked against their SHA-256.
    apollo="$ROOT/build/apollo.bin"
    apollosum=99d9af7f1ff20e63c393035513a655392818d66b4d7fc23d658175c1f15e8d76
    hash() { if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }
    [ -f "$apollo" ] && [ "$(hash "$apollo")" = "$apollosum" ] && exit 0
    echo "Fetching the restore model (66 MB) from Hugging Face"
    if curl -fL --retry 3 --silent --show-error -o "$apollo.part" \
        "https://huggingface.co/JusperLee/Apollo/resolve/c68bd80fdd9c0d93d2f4a833cb154624f660a561/pytorch_model.bin" &&
        [ "$(hash "$apollo.part")" = "$apollosum" ]; then
        mv "$apollo.part" "$apollo"
        exit 0
    fi
    rm -f "$apollo.part"
    echo "bin/model: couldn't fetch the restore model; the Sampler won't restore songs" >&2
    exit 1
fi

revision=cbc8a9b1a87023b7fd74e7b3412e6321c0eab003
file=955717e8.safetensors
sum=d9fa14133cfcc034a6758923bb3a8ca9f8dfd0b582134643bbf83f72c17576dd
url="https://huggingface.co/adefossez/HTDemucs/resolve/$revision/$file"
published="$ROOT/build/htdemucs.safetensors"

sha256() {
    if command -v sha256sum >/dev/null; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi
}
good() { [ -f "$1" ] && [ "$(sha256 "$1")" = "$sum" ]; }

if ! good "$published"; then
    cached="${HF_HOME:-$HOME/.cache/huggingface}/hub/models--adefossez--HTDemucs/snapshots/$revision/$file"
    if good "$cached"; then
        cp "$cached" "$published.part"
    else
        echo "Fetching the published stem model (84 MB) from Hugging Face"
        if ! curl -fL --retry 3 --silent --show-error -o "$published.part" "$url"; then
            rm -f "$published.part"
            echo "bin/model: couldn't fetch $url" >&2
            exit 1
        fi
    fi
    if ! good "$published.part"; then
        rm -f "$published.part"
        echo "bin/model: the published stem model isn't the one expected (SHA-256 $sum)" >&2
        exit 1
    fi
    mv "$published.part" "$published"
fi

tenfold="$ROOT/build/tenfold"
[ -x "$tenfold" ] || tenfold="$ROOT/build/tenfold.app/Contents/MacOS/tenfold"
if [ ! -x "$tenfold" ]; then
    echo "bin/model: build tenfold first (bin/build), it compacts the model" >&2
    exit 1
fi
"$tenfold" stem-model "$published" "$ROOT/extras/htdemucs-bits.txt" "$bundled.part"
mv "$bundled.part" "$bundled"
cp "$bundled" "$dest"
echo "Stem model remade at $bundled"
