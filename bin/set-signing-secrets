#!/bin/sh
# Hands the Mac signing keys to GitHub as repository secrets, so CI signs
# and notarizes tenfold.app (see the macos job in .github/workflows/build.yml).
#
#   bin/set-signing-secrets [folder]
#
# The folder (default ~/.local/share/tenfold-signing) holds:
#
#   developer-id.p12        the Developer ID Application certificate and its key
#   p12-password            the .p12's password
#   AuthKey_<id>.p8         an App Store Connect API key (Developer access)
#   notary-key-id           its key ID
#   notary-issuer           the team's issuer ID
#
# Nothing is printed; gh reads each secret from a pipe.
set -eu

dir="${1:-$HOME/.local/share/tenfold-signing}"
repo=maxberggren/tenfold

need() { [ -r "$dir/$1" ] || { echo "set-signing-secrets: $dir/$1 is missing" >&2; exit 1; }; }
need developer-id.p12
need p12-password
need notary-key-id
need notary-issuer
key=$(ls "$dir"/AuthKey_*.p8 2>/dev/null | head -n 1)
[ -n "$key" ] || { echo "set-signing-secrets: no AuthKey_*.p8 in $dir" >&2; exit 1; }

identity=$(openssl pkcs12 -in "$dir/developer-id.p12" -passin "file:$dir/p12-password" -legacy -nokeys -clcerts 2>/dev/null |
    openssl x509 -noout -subject -nameopt multiline | sed -n 's/^ *commonName *= *//p')
case "$identity" in
"Developer ID Application:"*) ;;
*) echo "set-signing-secrets: the .p12 holds no Developer ID Application certificate" >&2; exit 1 ;;
esac

base64 <"$dir/developer-id.p12" | tr -d '\n' | gh secret set MACOS_CERT_P12 --repo "$repo"
tr -d '\n' <"$dir/p12-password" | gh secret set MACOS_CERT_PASSWORD --repo "$repo"
printf '%s' "$identity" | gh secret set MACOS_SIGN_IDENTITY --repo "$repo"
base64 <"$key" | tr -d '\n' | gh secret set NOTARY_KEY_P8 --repo "$repo"
tr -d '\n' <"$dir/notary-key-id" | gh secret set NOTARY_KEY_ID --repo "$repo"
tr -d '\n' <"$dir/notary-issuer" | gh secret set NOTARY_ISSUER --repo "$repo"
echo "Signing as \"$identity\"; the next macos build signs and notarizes tenfold."
