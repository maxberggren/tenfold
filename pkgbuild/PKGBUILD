pkgname=tenfold
pkgver=0.6.0
pkgrel=1
pkgdesc='An instrument played with all ten fingers on the trackpad'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'polkit' 'pipewire')
makedepends=('gcc' 'make')
optdepends=('ffmpeg: record the picture with the sound; the Sampler reads any sound file, not only WAV'
            'yt-dlp: the Sampler takes a pasted link to a song')
source=()
sha256sums=()
options=('!debug') # one package, not a separate one of debug symbols

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/tenfold "$pkgdir/usr/bin/tenfold"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The stem separator's weights (bin/model copies them from extras/) and their licence.
  install -Dm644 build/htdemucs.tfq "$pkgdir/usr/share/$pkgname/htdemucs.tfq"
  install -Dm644 extras/LICENSE-htdemucs "$pkgdir/usr/share/licenses/$pkgname/LICENSE-htdemucs"
  # The restorer's weights and their licence.
  install -Dm644 build/apollo.tfq "$pkgdir/usr/share/$pkgname/apollo.tfq"
  install -Dm644 extras/LICENSE-apollo "$pkgdir/usr/share/licenses/$pkgname/LICENSE-apollo"
  install -Dm644 "$startdir/tenfold.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tenfold.svg"
  install -Dm644 "$startdir/tenfold.desktop" "$pkgdir/usr/share/applications/tenfold.desktop"
}
