<RCC>
    <qresource prefix="/">
        <file alias="Main.qml">Main.qml</file>
        <file>fonts/NotoSansMono-Regular.ttf</file>
        <file>fonts/NotoSansMono-Medium.ttf</file>
        <file>fonts/NotoSansMono-Bold.ttf</file>
        <file>fonts/NotoSansMono-Black.ttf</file>
        <file alias="HelpPage.qml">HelpPage.qml</file>
        <file alias="PanelBox.qml">PanelBox.qml</file>
        <file alias="PanelButton.qml">PanelButton.qml</file>
        <file alias="StatusLamp.qml">StatusLamp.qml</file>
        <file alias="TutorialPanel.qml">TutorialPanel.qml</file>
        <file alias="i18n/en.json">i18n/en.json</file>
    </qresource>
</RCC>
